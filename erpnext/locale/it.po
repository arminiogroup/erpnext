"        <li>\n"
"            <code>{{ supplier_name }}</code>: Il nome dell'azienda del fornitore.\n"
"        </li>\n"
"        <li>\n"
"            <code>{{ contact.salutation }} {{ contact.last_name }}</code>: La persona di contatto del fornitore.\n"
